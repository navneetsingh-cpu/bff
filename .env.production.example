# ---------------------------------------------------------------------------
# Production environment. Copy to .env.production and fill in:
#
#   cp .env.production.example .env.production
#   (PowerShell: Copy-Item .env.production.example .env.production)
#
# `.env.production` is gitignored. Unlike .env.example, the values marked
# REQUIRED have no fallback — `npm run up:prod` refuses to start without them,
# on purpose: a production stack silently booting with a dev secret is worse
# than one that doesn't boot.
#
# docker-compose.prod.yml is loaded with --env-file .env.production, so the
# dev `.env` is never read by the production stack.
# ---------------------------------------------------------------------------


# --- REQUIRED: internal assertion signing key -------------------------------
# The BFF signs one short-lived JWT per proxied request; the sub-apps verify it.
# Generate a fresh one — never reuse the dev value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_JWT_SECRET=

# --- REQUIRED: Redis password -----------------------------------------------
# Used both by the bundled redis service (--requirepass) and in the default
# REDIS_URL below. Generate the same way as above.
REDIS_PASSWORD=


# --- Publishing -------------------------------------------------------------
# The origin browsers use to reach the BFF, scheme included and no trailing
# slash. Every redirect the app issues — post-login, sign-out, the bounce to
# /api/auth/login — is built from this.
#
# Leave it blank and the origin is taken from the Host header instead, which is
# correct for a directly-published container but forgeable. Set it explicitly
# once anything sits in front of the app.
PUBLIC_ORIGIN=http://localhost:3000

# Loopback by default: the TLS terminator in front of the stack is what should
# be reachable from the network, not the app. Set to 0.0.0.0 only if something
# else already terminates TLS on this host.
BFF_BIND=127.0.0.1
BFF_PORT=3000

# Tags the built images: bff-starter/bff:<IMAGE_TAG>, and so on.
IMAGE_TAG=latest


# --- Authentication ---------------------------------------------------------
# `stub` shows a fake-user picker with no IdP — fine for a staging smoke test,
# never for anything real.
AUTH_MODE=oidc

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Must match a Web redirect URI on the app registration character for
# character, and must be https in production.
REDIRECT_URI=https://your-host.example.com/api/auth/callback

OIDC_SCOPE=openid profile email


# --- Session ----------------------------------------------------------------
# `__Host-` is only honoured by the browser on a Secure cookie, which needs
# HTTPS. NODE_ENV=production already sets Secure, so these two belong together.
SESSION_COOKIE_NAME=__Host-sid
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800

# Uncomment to use a managed Redis instead of the bundled service (and delete
# the redis service from docker-compose.prod.yml).
# REDIS_URL=rediss://:password@your-cache.example.com:6380


# --- Internal assertion -----------------------------------------------------
INTERNAL_JWT_ISSUER=bff
INTERNAL_JWT_TTL_SECONDS=60
