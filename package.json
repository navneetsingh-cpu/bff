{
  "name": "bff-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Dockerized Next.js 14 BFF with three basePath sub-apps behind an internal assertion JWT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "up:dev": "docker compose up --build",
    "down:dev": "docker compose down",
    "logs:dev": "docker compose logs -f",
    "ps": "docker compose -f docker-compose.prod.yml --env-file .env.production ps",
    "up": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --no-build",
    "down": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "restart": "docker compose -f docker-compose.prod.yml --env-file .env.production restart",
    "logs": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f",
    "logs:bff": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f bff",
    "logs:connect": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f connect",
    "logs:iif": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f iif",
    "logs:handbook": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f handbook",
    "redis": "docker compose -f docker-compose.prod.yml --env-file .env.production exec redis redis-cli",
    "redis:keys": "docker compose -f docker-compose.prod.yml --env-file .env.production exec -T redis redis-cli KEYS \"sess:*\"",
    "redis:watch": "docker compose -f docker-compose.prod.yml --env-file .env.production exec redis redis-cli MONITOR | node scripts/redis-monitor.mjs",
    "redis:watch:raw": "docker compose -f docker-compose.prod.yml --env-file .env.production exec redis redis-cli MONITOR",
    "redis:flush": "echo WARNING - FLUSHDB deletes every session and logs everyone out && docker compose -f docker-compose.prod.yml --env-file .env.production exec -T redis redis-cli FLUSHDB",
    "build:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production build",
    "up:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build",
    "down:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production down",
    "logs:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production logs -f",
    "ps:prod": "docker compose -f docker-compose.prod.yml --env-file .env.production ps",
    "dev:bff": "npm run dev --workspace=@bff/bff",
    "dev:connect": "npm run dev --workspace=@bff/connect",
    "dev:iif": "npm run dev --workspace=@bff/iif",
    "dev:handbook": "npm run dev --workspace=@bff/handbook",
    "build:bff": "npm run build --workspace=@bff/bff",
    "build:connect": "npm run build --workspace=@bff/connect",
    "build:iif": "npm run build --workspace=@bff/iif",
    "build:handbook": "npm run build --workspace=@bff/handbook",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.11.0",
    "npm": ">=10"
  },
  "devDependencies": {
    "typescript": "5.5.4",
    "@types/node": "22.10.2"
  }
}
