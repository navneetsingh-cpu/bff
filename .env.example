# ---------- Azure Entra ID (confidential client, certificate credential) ----------
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# PEM PKCS#8 private key for the app registration certificate.
# Newlines may be written as literal \n. In production load this from Key Vault.
AZURE_CLIENT_CERT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# SHA-1 thumbprint (hex, no colons) of the uploaded public certificate.
AZURE_CLIENT_CERT_THUMBPRINT=ABCDEF0123456789ABCDEF0123456789ABCDEF01
# Scopes requested for downstream APIs, space separated.
AZURE_SCOPES="openid profile offline_access User.Read"

# ---------- BFF ----------
# Public origin of the BFF. Must match the Entra redirect URI host.
BFF_PUBLIC_ORIGIN=https://localhost:8443
REDIRECT_URI=https://localhost:8443/api/auth/callback
POST_LOGOUT_REDIRECT_URI=https://localhost:8443/

# ---------- Session ----------
REDIS_URL=redis://redis:6379
# 32-byte key, base64. Placeholder for a Key Vault backed key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENC_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800

# ---------- Internal assertion (EdDSA / Ed25519) ----------
# Generate both with: pnpm keys
INTERNAL_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
INTERNAL_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# ---------- SPA handoff ----------
SPA_BASE_URL=https://localhost:8443/spa

# ---------- Local dev only ----------
# __Host- prefixed cookies require HTTPS. Set to "true" to fall back to a plain
# "sid" cookie without Secure so http://localhost works. Never set in production.
DEV_INSECURE_COOKIE=false
