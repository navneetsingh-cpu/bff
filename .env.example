# ---------------------------------------------------------------------------
# Copy to .env before the first `docker compose up`:
#
#   cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# Every value below has a working default in docker-compose.yml, so an empty
# .env still boots in stub mode. The file exists so you can override things
# without editing compose.
# ---------------------------------------------------------------------------


# --- Which port the BFF is published on -------------------------------------
# The only port exposed to the host. Sub-apps are never published.
BFF_PORT=3000


# --- Authentication ---------------------------------------------------------
# stub — a local form picks one of three seeded fake users. No IdP, no network.
#        This is the default and the right choice for local dev.
# oidc — Authorization Code + PKCE against Microsoft Entra. Requires the
#        AZURE_* values below and an app registration.
AUTH_MODE=stub


# --- Session ----------------------------------------------------------------
# Cookie name. Use `sid` locally: the `__Host-` prefix requires Secure, which
# requires HTTPS, which local dev over http://localhost doesn't have.
# In production set this to __Host-sid.
SESSION_COOKIE_NAME=sid

# Sliding window. The session dies this many seconds after the last request.
SESSION_IDLE_SECONDS=1800

# Hard ceiling. The session dies this many seconds after login no matter what.
SESSION_ABSOLUTE_SECONDS=28800

# Where sessions live. The sid cookie is an opaque 32-byte random value; all
# the actual identity data is server-side under this key space.
REDIS_URL=redis://redis:6379


# --- Internal assertion JWT -------------------------------------------------
# The BFF signs a short-lived JWT per proxied request; each sub-app verifies it.
# Symmetric HS256 with a shared secret for now — see the README for what to
# change before production.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_JWT_SECRET=dev-only-not-a-real-secret-change-me

# The `iss` claim the BFF sets and the sub-apps require.
INTERNAL_JWT_ISSUER=bff

# Assertion lifetime. Long enough to cross the container network, short enough
# that a captured token is worthless. Don't raise this to work around clock skew.
INTERNAL_JWT_TTL_SECONDS=60


# --- Microsoft Entra (only read when AUTH_MODE=oidc) ------------------------
# Left blank on purpose. Fill these in from your app registration:
#   Directory (tenant) ID          -> AZURE_TENANT_ID
#   Application (client) ID        -> AZURE_CLIENT_ID
#   A client secret value          -> AZURE_CLIENT_SECRET
# and add REDIRECT_URI below to the registration's Web redirect URIs.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Must match a redirect URI registered in Entra, exactly.
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Scopes requested at the authorize endpoint.
OIDC_SCOPE=openid profile email


# --- Dev ergonomics ---------------------------------------------------------
# File watching over a bind mount needs polling on Windows and macOS. Set to
# false on Linux for lower idle CPU.
WATCHPACK_POLLING=true
